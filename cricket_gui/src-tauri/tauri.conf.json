{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cricket",
  "version": "0.2.0",
  "identifier": "se.dpmstudios.cricket",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Cricket MIDI",
        "width": 980,
        "height": 860,
        "minWidth": 720,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "DPM Studios",
    "copyright": "Copyright (c) 2026 DPM Studios. Licensed under MIT OR Apache-2.0.",
    "category": "Music",
    "shortDescription": "MIDI over audio (AML v1)",
    "longDescription": "Cricket carries MIDI and MIDI Show Control over any spare audio channel (Dante, MADI, analog XLR) using the open AML v1 protocol.",
    "license": "MIT OR Apache-2.0",
    "licenseFile": "../../LICENSE-MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "entitlements": "Entitlements.plist"
    }
  }
}
